{
  "manifest_version": 3,
  "name": "MISHU",
  "version": "0.2.0",
  "description": "MISHU 的 Chrome 扩展：在页面上下文里发请求（带齐登录 cookie），并读取「新招呼」标签页的状态。",
  "permissions": ["cookies", "alarms", "tabs", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:39115/*",
    "https://zhipin.com/*",
    "https://*.zhipin.com/*"
  ],
  "action": {
    "default_title": "MISHU —— 点击同步 cookie"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.zhipin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
